# Esempio di variabili d'ambiente per lo sviluppo locale.
# Copiare in `.env` (non versionato) e compilare i valori.
# Il file .env viene caricato automaticamente da carrara/settings.py.

# Django
DJANGO_SECRET_KEY=genera-un-valore-lungo-e-casuale
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database PostgreSQL/PostGIS (default e anagrafe condividono le credenziali)
DJANGO_DB_NAME=carrara_prot_locale
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=

# Email (SMTP). In sviluppo si puo' usare la console backend
# impostando EMAIL_BACKEND in carrara/settings.py
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
